    <string name="perf_entity_shadows_summary">مەخلۇق ۋە ئوينىغۇچىلارنىڭ ئاستىدىكى سايىنى سىزمايدۇ.</string>
    <string name="perf_fast_graphics_title">تېز گرافىكا</string>
